# Copy this file to .env and fill in your own values.
# .env is loaded automatically (via the dotenv package) when the server starts.

# Secret used to sign/verify JWTs. Use a long random string in production.
JWT_SECRET=mysecretkey123456

# MongoDB connection string. Defaults to local MongoDB if not set.
MONGO_URI=mongodb://localhost:27017/zentora

# Port the API server listens on. Defaults to 3001 if not set.
PORT=3001
